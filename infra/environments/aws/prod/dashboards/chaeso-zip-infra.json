{
  "uid": "chzinfra1",
  "title": "Infra (DB/Redis) - chaeso-zip",
  "tags": ["postgres", "redis", "chaeso-zip", "infra"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Postgres Connections",
      "description": "postgres-exporter 필요 (monitoring profile)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "pg_stat_database_numbackends{datname=\"chaeso\"}", "legendFormat": "connections" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Redis Memory Used",
      "description": "redis-exporter 필요 (monitoring profile). maxmemory=64mb, noeviction 정책이라 이 값이 한계에 붙으면 쓰기 실패 시작됨",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "redis_memory_used_bytes", "legendFormat": "used" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Postgres Up",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "pg_up" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redis Up",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "redis_up" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Postgres Transaction Rate",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "rate(pg_stat_database_xact_commit{datname=\"chaeso\"}[5m])", "legendFormat": "commit" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "rate(pg_stat_database_xact_rollback{datname=\"chaeso\"}[5m])", "legendFormat": "rollback" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres Cache Hit Ratio",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname=\"chaeso\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"chaeso\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"chaeso\"}[5m])))", "legendFormat": "hit ratio" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Postgres Database Size",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "pg_database_size_bytes{datname=\"chaeso\"}", "legendFormat": "size" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis Connected Clients",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "redis_connected_clients", "legendFormat": "clients" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis Ops/sec",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "ops" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis Hit Rate",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * sum(rate(redis_keyspace_hits_total[5m])) / (sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])))", "legendFormat": "hit rate" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Redis Memory Usage %",
      "description": "maxmemory=64mb, noeviction 정책 — 이 값이 100%에 붙으면 쓰기 실패 시작됨",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "100 * redis_memory_used_bytes / redis_config_maxmemory", "legendFormat": "used %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Redis Rejected Connections",
      "description": "maxmemory 초과로 쓰기 거부될 때 증가 (noeviction 정책의 조기 경보)",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }, "expr": "rate(redis_rejected_connections_total[5m])", "legendFormat": "rejected" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    }
  ]
}
